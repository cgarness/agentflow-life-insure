  "reference_only_repair": {
    "id": "B6-uuid-cast-guard",
    "rationale": "Batch 6 correctness fix, applied to the reference only: report_v3_contact_identity cast substr(identity_key, 6)::uuid in a join condition guarded only by AND, so at scale the planner hashed on the cast for client keys and every call-based reader raised 22P02. The guard makes the cast evaluate only for lead keys; it changes no result the baseline could return.",
    "from": "ck.lead_id = substr(r.identity_key, 6)::uuid",
    "to": "ck.lead_id = CASE WHEN r.identity_key LIKE 'lead:%' THEN substr(r.identity_key, 6)::uuid END"
  },
