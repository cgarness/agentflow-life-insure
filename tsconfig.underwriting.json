{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noUncheckedIndexedAccess": true,
    "types": [
      "react",
      "react-dom"
    ]
  },
  "include": [
    "src/underwriting/**/*.ts",
    "src/underwriting/**/*.tsx"
  ],
  "exclude": [
    "src/underwriting/__tests__/**"
  ]
}
